// Grafana Alloy config for the Asustor Lockerstor 10 (192.168.1.5)
// Ships BOTH Docker container logs and host/server logs to the existing Loki.
//
// The Loki push URL is read from the LOKI_PUSH_URL env var (set in .env).
// It must be the EXTERNALLY reachable Loki gateway, e.g.
//   http://<node-or-ingress>:3100/loki/api/v1/push
//   https://loki.example.com/loki/api/v1/push   (if behind Traefik + TLS)

logging {
  level  = "info"
  format = "logfmt"
}

// ---------------------------------------------------------------------------
// Where everything gets written: the cluster's Loki, reached from the NAS.
// ---------------------------------------------------------------------------
loki.write "default" {
  endpoint {
    url = sys.env("LOKI_PUSH_URL")

    // Uncomment if your Loki ingress is protected with basic auth:
    // basic_auth {
    //   username = sys.env("LOKI_USERNAME")
    //   password = sys.env("LOKI_PASSWORD")
    // }
  }

  // Stamped onto every line so you can isolate this host in Grafana.
  external_labels = {
    host    = "asustor-lockerstor10",
    source  = "mediaserver",
  }
}

// ---------------------------------------------------------------------------
// Docker container logs — auto-discovers every container on the host.
// ---------------------------------------------------------------------------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = discovery.docker.containers.targets

  // /qbittorrent -> container="qbittorrent"
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  // compose service name, when present
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
  // stdout / stderr
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    target_label = "job"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.docker.rules
  forward_to    = [loki.write.default.receiver]
  refresh_interval = "15s"
}

// ---------------------------------------------------------------------------
// Host / server logs — tail the NAS's /var/log (mounted read-only).
// ---------------------------------------------------------------------------
local.file_match "varlogs" {
  path_targets = [
    {"__path__" = "/var/log/messages",  "job" = "varlogs", "host" = "asustor-lockerstor10"},
    {"__path__" = "/var/log/syslog",    "job" = "varlogs", "host" = "asustor-lockerstor10"},
    {"__path__" = "/var/log/*.log",     "job" = "varlogs", "host" = "asustor-lockerstor10"},
  ]
}

loki.source.file "varlogs" {
  targets    = local.file_match.varlogs.targets
  forward_to = [loki.write.default.receiver]
}
