# Set these in the Portainer stack's "Environment variables" fields.
TZ=America/New_York
# Loki push endpoint. loki-gateway is exposed as a Cilium LoadBalancer at
# 10.30.30.202 via the homelab-gitops repo (manifests/loki/values.yaml,
# gateway.service.type=LoadBalancer). The Asustor reaches the Compute VLAN from
# its Storage interface (10.20.20.5) for NFS, so this path is proven.
LOKI_PUSH_URL=http://10.30.30.202/loki/api/v1/push
