# Copy to .env for the monitoring stack (or set these in the Portainer stack UI).
TZ=America/New_York
# Where Alloy stores its config on the NAS (matches the volume mount).
ROOT=/share/Media
# Loki push endpoint. Loki (loki-gateway) is ClusterIP-only today, so expose it
# with a Cilium LoadBalancer from the homelab-pool (10.30.30.200-210, Compute VLAN)
# -- see monitoring/loki-push-lb.yaml. The Asustor already reaches the Compute VLAN
# from its Storage interface (10.20.20.5) for NFS, so this path is proven.
# Set this to the assigned LB IP once created, e.g. http://10.30.30.202/loki/api/v1/push
LOKI_PUSH_URL=http://10.30.30.202/loki/api/v1/push
