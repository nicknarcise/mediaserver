# Your timezone, https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York
# UNIX PUID and PGID. Containers run as the 'docker' service user (1000) in the
# shared 'users' group (100). Both 'docker' and 'admin' belong to 'users', so the
# media can be group-owned by users with 775 (group-writable) instead of 777 —
# the apps and admin (over SMB) can both write, no world-write needed.
PUID=1000
PGID=100
# The directory where data and configuration will be stored.
ROOT=/share/Media